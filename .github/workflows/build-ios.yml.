      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Set up Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.3'
      - name: Install CocoaPods
        run: gem install cocoapods --no-document
      - name: Build unsigned device IPA
        shell: bash
        run: |
          set -o pipefail
          bash scripts/ios/build-ipa.sh "$GITHUB_WORKSPACE" 2>&1 | tee ios-build.log
      - name: Upload IPA and port source
        uses: actions/upload-artifact@v4
        with:
          name: openGym-unsigned-IPA
          path: |
            artifacts/ios/openGym-unsigned.ipa
            ios-port.patch
            IOS_PORT.md
            LICENSE
            NOTICE.md
          if-no-files-found: error
          retention-days: 7
      - name: Upload build log
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ios-build-log
          path: ios-build.log
          if-no-files-found: ignore
          retention-days: 7
